#!/bin/sh
### BEGIN INIT INFO
# Provides:          ipaper-backend
# Required-Start:    $network
# Required-Stop:     $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
### END INIT INFO

set -eu

APP_ROOT="${IPAPER_ROOT:-/user/liuhanyu/iPaper}"
BACKEND_DIR="$APP_ROOT/backend"
DATA_DIR="${IPAPER_DATA_DIR:-/user/liuhanyu/.ipaper}"
PID_FILE="/tmp/ipaper-backend.pid"
LOG_FILE="${IPAPER_LOG_FILE:-/user/liuhanyu/logs/ipaper-backend.log}"
PYTHON="${IPAPER_PYTHON:-$BACKEND_DIR/venv/bin/python}"

start() {
  mkdir -p "$(dirname "$LOG_FILE")" "$DATA_DIR"
  if [ -x "$APP_ROOT/scripts/initd-ipaper-hysteria" ] && [ -f "$APP_ROOT/config/hysteria.json" ]; then
    "$APP_ROOT/scripts/initd-ipaper-hysteria" start
  fi
  if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    return 0
  fi
  rm -f "$PID_FILE"
  cd "$BACKEND_DIR"
  nohup env IPAPER_SYNC_ROLE=server IPAPER_DATA_DIR="$DATA_DIR" \
    IPAPER_ARXIV_PROXY_URL="${IPAPER_ARXIV_PROXY_URL:-http://127.0.0.1:18080}" \
    "$PYTHON" -m uvicorn main:app --host 127.0.0.1 --port 3000 \
    >>"$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"
}

stop() {
  if [ -f "$PID_FILE" ]; then
    pid=$(cat "$PID_FILE")
    kill "$pid" 2>/dev/null || true
    for _ in 1 2 3 4 5; do
      kill -0 "$pid" 2>/dev/null || break
      sleep 1
    done
    kill -9 "$pid" 2>/dev/null || true
    rm -f "$PID_FILE"
  fi
}

status() {
  if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    echo "ipaper-backend is running (pid $(cat "$PID_FILE"))"
    exit 0
  fi
  echo "ipaper-backend is stopped"
  exit 1
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  *) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
